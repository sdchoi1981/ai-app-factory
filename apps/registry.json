{
  "apps": [
    {
      "appId": "unitkit",
      "appName": "UnitKit",
      "description": "Offline unit converter for 12 measurement categories.",
      "platform": "android",
      "applicationId": "com.unitkit.converter",
      "versionName": "1.1",
      "versionCode": 2,
      "category": "tools",
      "status": "testing",
      "supportedLanguages": [
        "ko",
        "en"
      ],
      "monetization": {
        "ads": false,
        "analytics": false
      },
      "buildConfiguration": {
        "path": "apps/unitkit",
        "testFile": "test-conversions.js",
        "sharedPackages": []
      },
      "releaseConfiguration": {
        "enabled": false,
        "defaultTrack": "internal"
      },
      "privacyPolicyUrl": null,
      "privacy": {
        "dataCollected": [],
        "notes": "Preferences remain on device. Conversion inputs are not stored or transmitted."
      }
    },
    {
      "appId": "datekit",
      "appName": "DateKit",
      "description": "Offline date difference, date offset and D-day calculator.",
      "platform": "android",
      "applicationId": "com.factory.datekit",
      "versionName": "1.0.0",
      "versionCode": 1,
      "category": "tools",
      "status": "testing",
      "supportedLanguages": [
        "ko",
        "en",
        "ja"
      ],
      "monetization": {
        "ads": false,
        "analytics": false
      },
      "buildConfiguration": {
        "path": "apps/datekit",
        "testFile": "test.mjs",
        "sharedPackages": [
          "ui",
          "core"
        ]
      },
      "releaseConfiguration": {
        "enabled": false,
        "defaultTrack": "internal"
      },
      "privacyPolicyUrl": null,
      "privacy": {
        "dataCollected": [],
        "notes": "Date calculations stay on device. Selected dates are retained only in Android activity state; no network or analytics."
      }
    }
  ]
}
